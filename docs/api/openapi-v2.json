{
  "openapi": "3.1.0",
  "info": {
    "title": "Arduino LED Controller API v2",
    "version": "5.0.0-alpha.1",
    "description": "Moduláris HTTP API az Arduino LED Controller szerverhez."
  },
  "servers": [
    {
      "url": "/",
      "description": "Aktuális szerver"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Users"
    },
    {
      "name": "Arduino"
    },
    {
      "name": "LED"
    },
    {
      "name": "Schedules"
    },
    {
      "name": "Local schedules"
    },
    {
      "name": "Firmware"
    },
    {
      "name": "Events"
    },
    {
      "name": "Observability"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "led_session"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {},
          "meta": {
            "type": "object"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "success",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          },
          "meta": {
            "type": "object"
          }
        }
      },
      "Color": {
        "oneOf": [
          {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            ],
            "minItems": 3,
            "maxItems": 3
          },
          {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          {
            "type": "object",
            "required": [
              "red",
              "green",
              "blue"
            ],
            "properties": {
              "red": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "green": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "blue": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        ]
      },
      "LedCommand": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "brightness": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "effect": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "speed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "color": {
            "$ref": "#/components/schemas/Color"
          }
        },
        "additionalProperties": false
      },
      "PortableSchedule": {
        "type": "object",
        "required": [
          "day",
          "time",
          "leds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "leds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/LedCommand"
                },
                {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Sikeres válasz",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiSuccess"
            }
          }
        }
      },
      "Error": {
        "description": "Hibaválasz",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  },
