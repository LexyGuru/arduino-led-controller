[Unit]
Description=Arduino LED Controller V5 LXC Self Update
After=network-online.target arduino-led-controller-rust.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=CARGO_HOME=/root/.cargo
Environment=RUSTUP_HOME=/root/.rustup
Environment=PATH=/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/arduino-led-controller-update
Nice=10
