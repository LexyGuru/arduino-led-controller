[Unit]
Description=Arduino LED Controller Alpha.2 Staging
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/arduino-led-controller-staging.env
WorkingDirectory=/opt/arduino-led-controller-staging/current
ExecStart=/usr/bin/node /opt/arduino-led-controller-staging/current/server2_final.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/arduino-led-controller-staging /etc/arduino-led-controller-staging /opt/arduino-led-controller-staging

[Install]
WantedBy=multi-user.target
