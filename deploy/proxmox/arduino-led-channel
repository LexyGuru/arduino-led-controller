#!/usr/bin/env bash
set -Eeuo pipefail

CHANNEL_FILE="/etc/arduino-led-channel"
BRANCH_FILE="/etc/arduino-led-branch"

current="$(cat "$CHANNEL_FILE" 2>/dev/null || echo beta)"
branch="$(cat "$BRANCH_FILE" 2>/dev/null || echo next/v5-rearchitecture)"

echo "Arduino LED Controller LXC Channel"
echo
echo "Current channel: $current"
echo "Current branch:  $branch"
echo
echo "1) Stable / main"
echo "2) Beta / next/v5-rearchitecture"
echo "3) Cancel"
read -r -p "Választás: " choice

case "$choice" in
  1)
    printf '%s\n' stable > "$CHANNEL_FILE"
    printf '%s\n' main > "$BRANCH_FILE"
    ;;
  2)
    printf '%s\n' beta > "$CHANNEL_FILE"
    printf '%s\n' next/v5-rearchitecture > "$BRANCH_FILE"
    ;;
  3) exit 0 ;;
  *) echo "Érvénytelen választás." >&2; exit 2 ;;
esac

echo "CHANNEL_CHANGE=RECORDED"
echo "A tényleges GitHub update mechanizmus csak a Rust LXC release publish után aktiválódik."
