# Másold például ide: /root/arduino-led-controller-beta.env
# A fájl legyen root-only: chmod 600 /root/arduino-led-controller-beta.env

STAGING_PORT=3100
STAGING_BIND_HOST=127.0.0.1

# Alapállapotban a Beta LXC nem kapcsolódik valódi Arduino-hoz.
# Tartalék teszteszközhöz töltsd ki ezeket. A produkciós 10.0.0.123
# cél alapból tiltott.
STAGING_ARDUINO_IP=127.0.0.1
STAGING_ARDUINO_PORT=65535
STAGING_ARDUINO_API_PATH=/__release_staging_disabled__
STAGING_ARDUINO_API_KEY=<RELEASE_STAGING_DISABLED_API_KEY>

# Csak tudatos, külön engedéllyel állítható 1-re.
ALLOW_PRODUCTION_ARDUINO=0
