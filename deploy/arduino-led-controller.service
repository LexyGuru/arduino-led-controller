[Unit]
Description=Arduino LED Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arduino-led
Group=arduino-led
WorkingDirectory=/opt/arduino-led-controller
EnvironmentFile=-/etc/arduino-led-controller.env
ExecStart=/usr/bin/node /opt/arduino-led-controller/server2_final.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/arduino-led-controller/data /opt/arduino-led-controller/config /opt/arduino-led-controller/schedules

[Install]
WantedBy=multi-user.target
