# Arduino LED Controller V5 Rust LXC Server
LXC_BIND_HOST=0.0.0.0
LXC_BIND_PORT=3000
WEB_ROOT=/opt/arduino-led-controller/current/web

ARDUINO_PROTOCOL=http
ARDUINO_HOST=192.168.1.50
ARDUINO_PORT=80
ARDUINO_API_PATH=/CHANGE_ME_PRIVATE_PATH
ARDUINO_DEVICE_KEY=CHANGE_ME

# Natív Rust OTA; a jelszó szerveroldalon marad.
ARDUINO_OTA_PORT=65280
ARDUINO_OTA_PASSWORD=CHANGE_ME

# Destruktív webes OTA indítás külön tokennel védve.
LXC_OTA_CONTROL_TOKEN=CHANGE_ME

# Opcionális helyi firmware-katalógus JSON.
FIRMWARE_CATALOG_JSON=/var/lib/arduino-led-controller/firmware-catalog.json

RUST_LOG=arduino_led_lxc_server=info,tower_http=info
