NODE_ENV=production
PORT=3100
BIND_HOST=127.0.0.1

APP_DIR=/opt/arduino-led-controller-staging/current
DATA_DIR=/var/lib/arduino-led-controller-staging
CONFIG_DIR=/etc/arduino-led-controller-staging
SCHEDULES_DIR=/var/lib/arduino-led-controller-staging/schedules
FIRMWARE_DIR=/var/lib/arduino-led-controller-staging/firmware

# Release staging hardverizoláció. Az alapértékek nem érnek el LAN-eszközt.
# Valódi tartalék Arduino használatához add meg külön a STAGING_ARDUINO_*
# változókat az install-beta-lxc.sh futtatásakor vagy a saját konfigurációban.
ARDUINO_IP=127.0.0.1
ARDUINO_PORT=65535
ARDUINO_API_PATH=/__release_staging_disabled__
ARDUINO_API_KEY=<RELEASE_STAGING_DISABLED_API_KEY>
ARDUINO_TIMEOUT_MS=30000
ARDUINO_HEALTH_TIMEOUT_MS=30000
ARDUINO_STATUS_MONITOR_TIMEOUT_MS=30000
ARDUINO_STATUS_MONITOR_ENABLED=0

API_V2_ENABLED=1
API_V2_ALLOWED_ORIGIN=http://127.0.0.1:3100
COOKIE_SECURE=0

LOCAL_SCHEDULE_RUNNER_MODE=manual
LEGACY_LOCAL_SCHEDULE_ADAPTERS_ENABLED=1
LEGACY_SUPPRESS_LOCAL_SCHEDULE_CRON=1
LEGACY_SUPPRESS_STATUS_CRON=1

RELEASE_CHANNEL=beta
RELEASE_CANDIDATE=beta.2-gate
RELEASE_TARGET_VERSION=6.0.0-beta.2
RELEASE_GATE_REPORT_DIR=/var/lib/arduino-led-controller/release-gates
RELEASE_PROMOTION_APPROVAL_FILE=/var/lib/arduino-led-controller/release-gates/release-promotion-approval.json
RELEASE_GATE_MAX_AGE_HOURS=72
RELEASE_EXECUTION_RECEIPT_DIR=/var/lib/arduino-led-controller/release-execution
RELEASE_FINALIZATION_APPROVAL_FILE=/var/lib/arduino-led-controller/release-execution/release-finalization-approval.json
RELEASE_EXECUTION_RECEIPT_MAX_AGE_HOURS=168
RELEASE_ORCHESTRATION_STATE_FILE=/var/lib/arduino-led-controller/release-execution/release-orchestration-state.json
RELEASE_ORCHESTRATION_ARTIFACT_DIR=/var/lib/arduino-led-controller/release-execution/artifacts
RELEASE_ORCHESTRATION_ARTIFACT_INDEX_FILE=/var/lib/arduino-led-controller/release-execution/artifacts/release-index.json
RELEASE_PRODUCTION_GUARD_FILE=/var/lib/arduino-led-controller/release-execution/release-production-guard.json
RELEASE_PRODUCTION_GUARD_VERIFICATION_FILE=/var/lib/arduino-led-controller/release-execution/release-production-guard-verification.json
RELEASE_ORCHESTRATION_MAX_AGE_HOURS=168
