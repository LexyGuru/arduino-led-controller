NODE_ENV=production
PORT=3100
BIND_HOST=127.0.0.1

APP_DIR=/opt/arduino-led-controller-staging/current
DATA_DIR=/var/lib/arduino-led-controller-staging
CONFIG_DIR=/etc/arduino-led-controller-staging
SCHEDULES_DIR=/var/lib/arduino-led-controller-staging/schedules
FIRMWARE_DIR=/var/lib/arduino-led-controller-staging/firmware

# Alpha.2 staging hardverizoláció.
# Ezek az értékek szándékosan csak a helyi loopbackre mutatnak, ezért a
# staging sem a produkciós Arduino, sem más LAN-eszköz felé
# nem tud LED-, schedule- vagy OTA-parancsot küldeni.
ARDUINO_IP=127.0.0.1
ARDUINO_PORT=65535
ARDUINO_API_PATH=/__alpha2_staging_disabled__
ARDUINO_API_KEY=<STAGING_DISABLED_API_KEY>
ARDUINO_TIMEOUT_MS=500
ARDUINO_HEALTH_TIMEOUT_MS=500
ARDUINO_STATUS_MONITOR_ENABLED=0

API_V2_ENABLED=1
API_V2_ALLOWED_ORIGIN=http://127.0.0.1:3100
COOKIE_SECURE=0

LOCAL_SCHEDULE_RUNNER_MODE=manual
LEGACY_LOCAL_SCHEDULE_ADAPTERS_ENABLED=1
LEGACY_SUPPRESS_LOCAL_SCHEDULE_CRON=1
LEGACY_SUPPRESS_STATUS_CRON=1

RELEASE_CHANNEL=alpha
RELEASE_CANDIDATE=alpha.2-gate
RELEASE_TARGET_VERSION=5.0.0-alpha.2

RELEASE_GATE_REPORT_DIR=/var/lib/arduino-led-controller/release-gates
RELEASE_PROMOTION_APPROVAL_FILE=/var/lib/arduino-led-controller/release-gates/alpha2-promotion-approval.json
RELEASE_GATE_MAX_AGE_HOURS=72
RELEASE_EXECUTION_RECEIPT_DIR=/var/lib/arduino-led-controller/release-execution
RELEASE_FINALIZATION_APPROVAL_FILE=/var/lib/arduino-led-controller/release-execution/alpha2-finalization-approval.json
RELEASE_EXECUTION_RECEIPT_MAX_AGE_HOURS=168
RELEASE_ORCHESTRATION_STATE_FILE=/var/lib/arduino-led-controller/release-execution/alpha2-orchestration-state.json
RELEASE_ORCHESTRATION_ARTIFACT_DIR=/var/lib/arduino-led-controller/release-execution/artifacts
RELEASE_ORCHESTRATION_ARTIFACT_INDEX_FILE=/var/lib/arduino-led-controller/release-execution/artifacts/index.json
RELEASE_PRODUCTION_GUARD_FILE=/var/lib/arduino-led-controller/release-execution/production-guard.json
RELEASE_PRODUCTION_GUARD_VERIFICATION_FILE=/var/lib/arduino-led-controller/release-execution/production-guard-verification.json
RELEASE_ORCHESTRATION_MAX_AGE_HOURS=168
