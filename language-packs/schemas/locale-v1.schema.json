{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LexyGuru/arduino-led-controller/language-packs/schemas/locale-v1.schema.json",
  "title": "Arduino LED Controller Language Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "packVersion",
    "minAppVersion",
    "translations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "packVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "minAppVersion": {
      "type": "string",
      "minLength": 1
    },
    "translations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
