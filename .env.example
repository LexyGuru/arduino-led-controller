# Arduino hálózati címe
ARDUINO_IP=10.0.0.117
ARDUINO_PORT=80

# Az Arduino secrets.h fájljában megadott privát útvonal és kulcs.
ARDUINO_API_PATH=/CHANGE_THIS_TO_A_LONG_RANDOM_API_PATH
ARDUINO_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_API_SECRET

# Egyszerű, visszafelé kompatibilis API v2 Bearer token.
API_V2_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_BEARER_TOKEN
API_V2_ROLE=admin

# Több API v2 token használatakor JSON tömb adható meg.
# Ez az egytokenes beállítást felülírja.
# API_V2_TOKENS_JSON=[{"id":"desktop","token":"LONG_RANDOM_TOKEN","role":"admin","enabled":true},{"id":"mobile","token":"OTHER_LONG_RANDOM_TOKEN","role":"operator","enabled":true}]
API_V2_TOKENS_JSON=

API_V2_ALLOWED_ORIGIN=*

# A helyi webes munkamenetek sütibeállítása.
COOKIE_SECURE=1
SESSION_DURATION_MS=43200000

# Realtime V5 eseménytörténet és az új Socket.IO kliens kezdeti csomagja.
EVENT_HISTORY_LIMIT=200
SOCKET_RECENT_EVENT_LIMIT=25

# Helyi schedule repository. Üresen a schedules könyvtár alapértékei élnek.
LOCAL_SCHEDULES_FILE=
LOCAL_SCHEDULE_BACKUP_DIR=

# manual: csak API-hívásra fut az új V5 runner.
# active: automatikusan fut. A legacy cron kikapcsolásáig NE állítsd active-ra.
LOCAL_SCHEDULE_RUNNER_MODE=active
LOCAL_SCHEDULE_RUNNER_INTERVAL_MS=15000
TZ=Europe/Vienna

# Arduino OTA és GitHub firmware release.
OTA_PASSWORD=
OTA_PORT=65280
OTA_USERNAME=arduino
OTA_TOOL_PATH=
FIRMWARE_REPOSITORY=LexyGuru/arduino-led-controller
FIRMWARE_RELEASE_TAG=firmware-latest
FIRMWARE_MAXIMUM_BYTES=16777216
FIRMWARE_UPLOAD_TIMEOUT_MS=240000
FIRMWARE_RESTART_TIMEOUT_MS=90000

# Opcionális GitHub token privát release vagy magasabb API-limit esetén.
GITHUB_TOKEN=

# Webszerver
PORT=3000
BIND_HOST=127.0.0.1

# Arduino HTTP-időkorlátok
ARDUINO_TIMEOUT_MS=30000
ARDUINO_HEALTH_TIMEOUT_MS=2500

LOG_LEVEL=info

# Tartós eseménytár és auditnapló.
EVENT_STORE_FILE=
EVENT_ARCHIVE_DIR=
EVENT_STORE_MAXIMUM_BYTES=5242880
EVENT_STORE_MAXIMUM_ARCHIVES=5
AUDIT_FILE=
AUDIT_MAXIMUM_BYTES=5242880
AUDIT_MAXIMUM_ARCHIVES=5

# OpenAPI 3.1 dokumentum. Üresen a docs/api/openapi-v2.json használatos.
OPENAPI_DOCUMENT_FILE=

# Szabályos leállítás előtt ennyi ideig futnak a cleanup feladatok.
SHUTDOWN_GRACE_MS=10000

# Legacy web/API kompatibilitási adapterek.
LEGACY_API_ADAPTERS_ENABLED=1
# A legacy cron memóriája miatt ezt egyelőre hagyd 0 értéken.
LEGACY_LOCAL_SCHEDULE_ADAPTERS_ENABLED=1
LEGACY_SOCKET_EVENT_BRIDGE_ENABLED=1
LEGACY_SUPPRESS_SIGNAL_HANDLERS=1

HTTP_SHUTDOWN_TIMEOUT_MS=8000



# Legacy cutover. Ezekkel a V5 szolgáltatások váltják ki a monolit cronokat.
LEGACY_SUPPRESS_LOCAL_SCHEDULE_CRON=1
LEGACY_SUPPRESS_STATUS_CRON=1

# Közös Arduino státuszmonitor és konzolcache.
ARDUINO_STATUS_MONITOR_ENABLED=1
ARDUINO_STATUS_MONITOR_INTERVAL_MS=30000
ARDUINO_STATUS_MONITOR_TIMEOUT_MS=5000
ARDUINO_CONSOLE_CACHE_LIMIT=200
ARDUINO_CONSOLE_MAX_PAGES=24
ARDUINO_CONSOLE_CACHE_TTL_MS=2500

# Schedule fájlkezelés. Az Arduino upload endpoint csak akkor legyen kitöltve,
# ha a firmware ténylegesen támogatja a JSON POST feltöltést.
SCHEDULE_FILE_MAXIMUM_BYTES=1048576
ARDUINO_SCHEDULE_UPLOAD_ENDPOINT=

# A public/ könyvtár moduláris statikus kiszolgálása.
STATIC_WEB_ASSETS_ENABLED=1
STATIC_WEB_CACHE_SECONDS=300
