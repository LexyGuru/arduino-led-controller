# Arduino hálózati címe
ARDUINO_IP=10.0.0.117
ARDUINO_PORT=80

# Az Arduino secrets.h fájljában megadott privát útvonal és kulcs.
ARDUINO_API_PATH=/CHANGE_THIS_TO_A_LONG_RANDOM_API_PATH
ARDUINO_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_API_SECRET

# Egyszerű, visszafelé kompatibilis API v2 Bearer token.
API_V2_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_BEARER_TOKEN
API_V2_ROLE=admin

# Több API v2 token használatakor JSON tömb adható meg.
# Ez az egytokenes beállítást felülírja.
# API_V2_TOKENS_JSON=[{"id":"desktop","token":"LONG_RANDOM_TOKEN","role":"admin","enabled":true},{"id":"mobile","token":"OTHER_LONG_RANDOM_TOKEN","role":"operator","enabled":true}]
API_V2_TOKENS_JSON=

API_V2_ALLOWED_ORIGIN=*

# A helyi webes munkamenetek sütibeállítása.
COOKIE_SECURE=1
SESSION_DURATION_MS=43200000

# Realtime V5 eseménytörténet és az új Socket.IO kliens kezdeti csomagja.
EVENT_HISTORY_LIMIT=200
SOCKET_RECENT_EVENT_LIMIT=25

# Helyi schedule repository. Üresen a schedules könyvtár alapértékei élnek.
LOCAL_SCHEDULES_FILE=
LOCAL_SCHEDULE_BACKUP_DIR=

# manual: csak API-hívásra fut az új V5 runner.
# active: automatikusan fut. A legacy cron kikapcsolásáig NE állítsd active-ra.
LOCAL_SCHEDULE_RUNNER_MODE=manual
LOCAL_SCHEDULE_RUNNER_INTERVAL_MS=15000
TZ=Europe/Vienna

# Arduino OTA és GitHub firmware release.
OTA_PASSWORD=
OTA_PORT=65280
OTA_USERNAME=arduino
OTA_TOOL_PATH=
FIRMWARE_REPOSITORY=LexyGuru/arduino-led-controller
FIRMWARE_RELEASE_TAG=firmware-latest
FIRMWARE_MAXIMUM_BYTES=16777216
FIRMWARE_UPLOAD_TIMEOUT_MS=240000
FIRMWARE_RESTART_TIMEOUT_MS=90000

# Opcionális GitHub token privát release vagy magasabb API-limit esetén.
GITHUB_TOKEN=

# Webszerver
PORT=3000
BIND_HOST=127.0.0.1

# Arduino HTTP-időkorlátok
ARDUINO_TIMEOUT_MS=30000
ARDUINO_HEALTH_TIMEOUT_MS=2500

LOG_LEVEL=info
