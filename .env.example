# Arduino hálózati címe
ARDUINO_IP=10.0.0.117
ARDUINO_PORT=80

# Az Arduino secrets.h fájljában megadott API_PRIVATE_PATH és API_SHARED_SECRET.
# A valós értékek kizárólag /etc/arduino-led-controller.env fájlban legyenek.
ARDUINO_API_PATH=/CHANGE_THIS_TO_A_LONG_RANDOM_API_PATH
ARDUINO_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_API_SECRET

# Az Arduino secrets.h fájlában megadott OTA_PASSWORD. Ezt csak a Proxmox
# /etc/arduino-led-controller.env fájljában állítsd be, GitHubra ne kerüljön.
OTA_PASSWORD=

# A GitHubon lefordított firmware forrása
FIRMWARE_REPOSITORY=LexyGuru/arduino-led-controller
FIRMWARE_RELEASE_TAG=firmware-latest

# A webes kezelőfelület portja
PORT=3000
BIND_HOST=127.0.0.1
COOKIE_SECURE=1

# Arduino HTTP-válasz maximális várakozási ideje (ezredmásodperc)
ARDUINO_TIMEOUT_MS=30000

# Europe/Vienna: magyar időzóna, a heti időzítések ehhez igazodnak
TZ=Europe/Vienna

# Opcionális naplózási szint: error, warn, info, debug
LOG_LEVEL=info
