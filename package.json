{
  "name": "arduino-led-controller",
  "version": "1.0.0",
  "private": true,
  "description": "Arduino UNO R4 WiFi LED controller and weekly scheduler",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server2_final.js",
    "check": "node --check server2_final.js && node --check desktop/main.cjs",
    "desktop:dev": "electron .",
    "desktop:prepare-ota": "node desktop/prepare-ota.cjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "hu.lexyguru.arduinoledcontroller",
    "productName": "Arduino LED Controller",
    "asar": false,
    "files": [
      "server2_final.js",
      "desktop/**/*",
      "tools/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage", "deb"] }
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fs-extra": "^11.3.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.0.7",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
