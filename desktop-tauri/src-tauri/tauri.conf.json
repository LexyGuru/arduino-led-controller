{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arduino LED Controller",
  "version": "2.0.0",
  "identifier": "hu.lexyguru.arduinoledcontroller",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "Arduino LED Controller", "width": 1380, "height": 900, "minWidth": 920, "minHeight": 640 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';" } },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Arduino LED Controller",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
